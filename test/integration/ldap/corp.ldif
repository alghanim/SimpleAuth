# Seed for the corp.local directory (shared by `central` and `standalone-ad`,
# i.e. the SAME-AD scenario). Vanilla OpenLDAP attrs — SimpleAuth is pointed at
# username_attr=uid, so User.SAMAccountName is populated from `uid`.
dn: ou=users,dc=corp,dc=local
objectClass: organizationalUnit
ou: users

dn: uid=bob,ou=users,dc=corp,dc=local
objectClass: inetOrgPerson
cn: Bob Builder
sn: Builder
uid: bob
mail: bob@corp.local
userPassword: bobpass

# bob is a member of the "Finance" group. The osixia image enables the memberof
# overlay by default, but configured for groupOfUniqueNames/uniqueMember (NOT
# groupOfNames/member — those get no memberOf). The overlay stamps bob with
# memberOf: cn=Finance,ou=groups,dc=corp,dc=local — the DN-shaped value real AD
# emits, from which SimpleAuth extracts the CN ("Finance") for group->role.
dn: ou=groups,dc=corp,dc=local
objectClass: organizationalUnit
ou: groups

dn: cn=Finance,ou=groups,dc=corp,dc=local
objectClass: groupOfUniqueNames
cn: Finance
uniqueMember: uid=bob,ou=users,dc=corp,dc=local
